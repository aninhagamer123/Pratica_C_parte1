#include <stdio.h>

int podeDoar(char g, float p) {

    if(g == 'f' && p >= 50) {
        return 1;
    }

    if(g == 'm' && p >= 60) {
        return 1;
    }

    return 0;
}

int main(void) {

    char g;
    float p;

    printf("Digite seu gênero (m ou f):\n");
    scanf(" %c", &g);

    printf("Digite seu peso em kg:\n");
    scanf("%f", &p);

    if(podeDoar(g, p)) {
        printf("Você pode doar sangue!\n");
    } else {
        printf("Você não pode doar sangue!\n");
    }

    return 0;
}

