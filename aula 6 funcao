#include <stdio.h>

void divisao(int, int);

int main(void) {

 int dividendo;
 int divisor;
 
 printf("Digite o dividendo:\n");
 scanf("%d", &dividendo);

 printf("Digite o divisor:\n");
 scanf("%d", &divisor);
 
 divisao(dividendo, divisor);

  return 0;
}

void divisao(int a, int b) {
    
  int quociente = 0;
  
  while(a >= b)
  {
         a = a - b;
         quociente++;
  }
  printf("O quociente é %d com resto %d", quociente, a);
}

