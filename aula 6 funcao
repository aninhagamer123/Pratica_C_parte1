#include <stdio.h>

int dataMagica(int dia, int mes, int ano)
{
    int ano2dig = ano % 100;

    if (dia * mes == ano2dig)
    {
        return 1;
    }

    return 0;
}

int main(void)
{
    for (int ano = 1901; ano <= 1999; ano++)
    {
        for (int mes = 1; mes <= 12; mes++)
        {
            for (int dia = 1; dia <= 31; dia++)
            {
                if (dataMagica(dia, mes, ano))
                {
                    printf("A data %d/%d/%d é mágica\n",
                           dia, mes, ano);
                }
            }
        }
    }

    return 0;
}
