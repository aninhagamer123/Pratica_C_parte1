#include <stdio.h>
#include <stdlib.h>

int main(void)
{
    srand(seed);

    int m[5][6];

    // Preenche e imprime a matriz
    for(int i = 0; i < 5; i++)
    {
        for(int j = 0; j < 6; j++)
        {
            m[i][j] = rand() % 1001;
            printf("%4d ", m[i][j]);
        }

        printf("\n");
    }

    // Procura o menor elemento da matriz
    int menor = m[0][0];
    int linhaMenor = 0;

    for(int i = 0; i < 5; i++)
    {
        for(int j = 0; j < 6; j++)
        {
            if(m[i][j] < menor)
            {
                menor = m[i][j];
                linhaMenor = i;
            }
        }
    }

    // Procura o maior elemento da linha onde está o menor
    int minimax = m[linhaMenor][0];
    int colunaMinimax = 0;

    for(int j = 1; j < 6; j++)
    {
        if(m[linhaMenor][j] > minimax)
        {
            minimax = m[linhaMenor][j];
            colunaMinimax = j;
        }
    }

    printf("MINMAX=%d na linha %d coluna %d\n",
           minimax,
           linhaMenor,
           colunaMinimax);

    return 0;
}
