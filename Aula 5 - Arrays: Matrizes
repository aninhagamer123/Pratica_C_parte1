#include <stdio.h>
#include <stdlib.h>

int main(void) {
    srand(seed);

    int m[12][12];
    int soma = 0;

    // Preencher a matriz
    for (int i = 0; i < 12; i++) {
        for (int j = 0; j < 12; j++) {
            m[i][j] = rand() % 101;
        }
    }

    // Imprimir a matriz
    for (int i = 0; i < 12; i++) {
        for (int j = 0; j < 12; j++) {
            printf("%3d ", m[i][j]);
        }
        printf("\n");
    }

    // Somar os elementos abaixo da diagonal
    for (int i = 0; i < 12; i++) {
        for (int j = 0; j < 12; j++) {

            if (i > j) {
                soma = soma + m[i][j];
            }

        }
    }

    printf("Soma: %d", soma);

    return 0;
}

