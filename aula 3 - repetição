#include <stdio.h>

int main() {
    int numero;
    int contador = 0;
    int soma = 0;
    int media = 0; // Mudado para int para exibir sem casas decimais

    while (1) {
        // A plataforma exige essa mensagem antes de ler cada número
        printf("Digite um número:\n");
        scanf("%d", &numero);
        
        if (numero == 0) {
            break;
        }
        
        soma += numero;
        contador++;
    }

    if (contador > 0) {
        media = soma / contador; // Divisão inteira truncada
    }

    // Exibe os resultados exatamente no formato exigido
    printf("Você digitou %d números\n", contador);
    printf("O somatório dos números é %d\n", soma);
    printf("Média = %d\n", media);

    return 0;
}


