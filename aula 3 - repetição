#include <stdio.h>

int main() {
    int idade;
    float custo_total = 0.0;

    while (1) {
        // Texto exigido antes de ler cada idade
        printf("Digite a idade do visitante:\n");
        scanf("%d", &idade);

        if (idade == 0) {
            break;
        }

        if (idade <= 2) {
            custo_total += 0.00;
        } 
        else if (idade >= 3 && idade <= 12) {
            custo_total += 14.00;
        } 
        else if (idade >= 65) {
            custo_total += 18.00;
        } 
        else {
            custo_total += 23.00;
        }
    }

    // Texto exato exigido no resultado final
    printf("O Valor do grupo é %.2f\n", custo_total);

    return 0;
}

