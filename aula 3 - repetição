#include <stdio.h>

int main() {
    int numero, i;

    // Mensagem solicitando o número ao usuário
    printf("Digite um número:\n");
    // Lê o número n
    if (scanf("%d", &numero) == 1) 
    {
        // Gera o par de linhas de 1 até n
        for (i = 1; i <= numero; i++) {
            // Primeira linha do par
            printf("%d %d %d\n", i, i * i, i * i * i);
            
            // d = avisa o pc oq deve ler ou exibir o numero um inteiro
            // Segunda linha do par
            printf("%d %d %d\n", i, (i * i) + 1, (i * i * i) + 1);
        }
    }

    return 0;
}
