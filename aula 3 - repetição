#include <stdio.h>

int main() {

    int N;

    printf("Digite um número:\n");
    scanf("%d", &N);

    int anterior = 0;
    int atual = 1;

    for (int i = 0; i < N; i++) {

        printf("%d", anterior);

        int proximo = anterior + atual;

        anterior = atual;
        atual = proximo;

        if (i < N - 1) {
            printf(" ");
        }
    }

    return 0;
}

